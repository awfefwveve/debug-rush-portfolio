  m_Script: {fileID: 11500000, guid: 40bd741bfbcabbe43b19f4467502735b, type: 3}
  m_Name: Stage_1_1
  m_EditorClassIdentifier: Assembly-CSharp::StageData
  chapter: 1
  stage: 1
  displayName: 1-1
  summary: "\uCCAB \uBC88\uC9F8 \uC608\uC678 \uBC1C\uC0DD"
  sceneName: Stage
  timeLimit: 120
  timeMultiplier:
  - 1.3
  - 1
  - 0.8
  terminalGoal: 020000000300000004000000
  requestTime:
  - 45
  - 36
  - 29
  monsters:
  - prefab: {fileID: 5659492794940413673, guid: 6d4c9207568a08f449cb4cd2d4d113e7, type: 3}
    patternCount: 2
    patternMask: 3
    spawnPos: {x: 3, y: 3}
    tuning:
      speedGap: 3.5
      cooldown:
      - 3.5
      - 14
      parryChance: 0.5
      fanAngle: 18
      fieldDuration: 2.5
      fieldRadius: 2
      mineDetect: 1.8
      mineDelay: 1
      mineRadius: 1.6
      maxMines: 3
  playerInvincibleTime: 1.5
  newMonsterPatternMask: 1
  intro:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC73C\u2026 \uBA38\uB9AC\uC57C. \uB098\u2026 \uACFC\uBC29\uC5D0\uC11C
      \uC878\uACE0 \uC788\uC5C8\uB098? \uBD84\uBA85 \uD504\uB85C\uC81D\uD2B8 \uB9C8\uBB34\uB9AC\uB97C
      \uD558\uACE0\uC788\uC5C8\uB294\uB370\u2026"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC7A0\uAE50\uB9CC, \uC800\uAC74\u2026 \uB0B4\uAC00 \uB9CC\uB4E4\uACE0
      \uC788\uB294 \uAC8C\uC784\uC5D0\uC11C \uB098\uC624\uB294 \uBAAC\uC2A4\uD130?!
      \uC5B4\uB5BB\uAC8C \uB41C\uAC70\uC57C?"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC800 NPC \uBC84\uADF8\uC5D0 \uBB3C\uB4E4\uC5EC\uC838 \uC2E4\uC81C\uB85C
      \uAC8C\uC784\uC5D0\uC11C \uB098\uC628\uAC74\uAC00? \uADF8\uB7F0\uAC70 \uAC00\uB2A5\uD560\uB9AC\uAC00\u2026!"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uAE08\uBC29 \uACF5\uACA9\uD574\uC62C\uAC70\uC57C, \uC774\uB7F4 \uC2DC\uAC04
      \uC5C6\uC5B4 \uBE68\uB9AC \uBC84\uADF8\uB97C \uB9C9\uACE0 \uACE0\uCCD0\uC57C\uD574!"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC88B\uC544, \uB2F9\uD669\uD558\uC9C0\uB9D0\uACE0\u2026"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uBC84\uADF8 \uB2E8\uB9D0\uAE30\uB9CC \uC81C\uB300\uB85C \uC218\uB9AC\uD574\uC11C
      \uB370\uC774\uD130\uB9CC \uBCF5\uAD6C\uD558\uBA74 \uD0C8\uCD9C\uD560 \uC218
      \uC788\uC744 \uAC70\uC57C. \uC870\uD569 \uC7AC\uB8CC\uBD80\uD130 \uBE60\uB974\uAC8C
      \uCC3E\uC544\uC11C \uB2E8\uB9D0\uAE30\uC5D0 \uAF42\uC790!"
    portrait: {fileID: 0}
  outro:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uD6C4\uC6B0\u2026 \uC77C\uB2E8, \uBCF5\uAD6C\uB97C \uB05D\uB0C8\uB294\uB370\u2026
      \uC544\uC9C1 \uAC8C\uC784\uC774 \uACE0\uCCD0\uC9C0\uC9C0 \uC54A\uC740\uAC78\uBCF4\uB2C8
      \uC544\uB9C8 \uB354 \uB0A8\uC544\uC788\uB294 \uAC83 \uAC19\uB124."
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: 
    portrait: {fileID: 0}
