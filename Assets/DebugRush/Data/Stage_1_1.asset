  monsters:
  - prefab: {fileID: 5659492794940413673, guid: 6d4c9207568a08f449cb4cd2d4d113e7, type: 3}
    patternCount: 2
    spawnPos: {x: 3, y: 3}
  intro:
  - speaker: "\uB098"
    text: "\uBC24\uC0C8 \uD300\uC6D0\uB4E4\uC774\uB791 \uB9CC\uB4E0 \uBE4C\uB4DC... \uB4DC\uB514\uC5B4 \uC2E4\uD589\uD55C\uB2E4!"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "...\uC5B4? \uD654\uBA74\uC774 \uC0C8\uAE4C\uB9E4\uC84C\uC5B4. \uC800 \uBE5B\uC740 \uBB50\uC9C0? \uBE68\uB824 \uB4E4\uC5B4\uAC04\uB2E4...!"
    portrait: {fileID: 0}
  - speaker: "\uC2DC\uC2A4\uD15C"
    text: "\uACBD\uACE0: \uB370\uC774\uD130 \uB0B4\uBD80 \uC9C4\uC785. \uBC84\uADF8 \uBAAC\uC2A4\uD130\uAC00 \uCF54\uB4DC\uB97C \uAC09\uC544\uBA39\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC5EC\uAE34 \uC6B0\uB9AC \uAC8C\uC784 \uC18D\uC774\uC796\uC544! \uB9F5 \uACF3\uACF3\uC758 \uC5D0\uB7EC\uB97C \uACE0\uCCD0\uC11C \uB514\uBC84\uAE45\uC744 \uB05D\uB0B4\uC57C \uD604\uC2E4\uB85C \uB3CC\uC544\uAC00... \uACFC\uC81C\uB3C4 \uC81C\uCD9C\uD560 \uC218 \uC788\uC5B4!"
    portrait: {fileID: 0}
  outro:
  - speaker: "\uB098"
    text: "\uCCAB \uBC88\uC9F8 \uC624\uB958 \uC218\uC815 \uC644\uB8CC. \uC870\uAE08\uC529
      \uAC10\uC774 \uC7A1\uD78C\uB2E4."
    portrait: {fileID: 0}
  layout:
    use: 0
    playerStart: {x: 0, y: -3.4}
    planning: {x: 5, y: -3.2}
    programming: {x: 9, y: -3.2}
    graphic: {x: -9, y: 3.2}
