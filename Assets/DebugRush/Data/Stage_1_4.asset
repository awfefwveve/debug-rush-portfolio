  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uB2E4\uB978 \uBC84\uADF8\uB4E4\uC740 \uC5B4\uB514\uB85C\uAC04\uAC70\uC9C0\u2026"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uB3C4\uB300\uCCB4 \uB098\uAC00\uB294 \uAE38\uC774\u2026 \uC544! \uC800\uAC74
      \uB3C4\uC6C0 NPC!"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC774\uCABD\uC774\uC57C! \uB108\uB3C4 \uB2E4\uC2DC \uAC8C\uC784\uC5D0
      \uB4E4\uC5B4\uAC00\uC57C\uC9C0!"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC5B4\u2026?"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC7A0\uAE50 \uC7A0\uAE50!!"
    portrait: {fileID: 0}
  outro:
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uB3C4\uC6C0 NPC\uAE4C\uC9C0 \uBC84\uADF8\uC5D0 \uB2F9\uD588\uB2E4\uB2C8\u2026"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uD50C\uB808\uC774\uC5B4\uD55C\uD14C \uB3C4\uC6C0\uC8FC\uB77C\uACE0 \uB9CC\uB4E0\uAC74\uB370!
      \uACF5\uACA9\uC774\uB098 \uD558\uACE0 \uB9D0\uC774\uC57C!"
    portrait: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uADF8\uB798\uB3C4 \uC5B4\uB450\uC6CC\uC9C4\uAC8C \uB9CE\uC774 \uC5C6\uC5B4\uC9C4\uAC78
      \uBCF4\uB2C8 \uAC70\uC758 \uB2E4 \uACE0\uCCD0\uC9C4\uAC70\uAC19\uC544. \uC5BC\uB9C8
      \uC548\uB0A8\uC558\uC5B4."
    portrait: {fileID: 0}
